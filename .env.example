# API Base URL
# Local development: http://127.0.0.1:8001
# Vercel: Configure via Vercel dashboard environment variables
VITE_API_BASE_URL=http://127.0.0.1:8001

# Academic publication/student APIs now route through DeanAgent-Backend
# via /academic-monitor/api/... under VITE_API_BASE_URL.
# Keep local and deployed traffic on the same backend base.

# Internal LLM Chat Completions
INTERNAL_LLM_CHAT_COMPLETIONS_URL=https://llm.zgci.org/hub/v1/chat/completions
INTERNAL_LLM_API_KEY=replace-with-local-secret
INTERNAL_LLM_QUESTION_MODEL=glm
